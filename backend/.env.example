# Puerto en el que corre el servidor
PORT=4000

# URI de conexion a MongoDB
MONGODB_URI=mongodb://admin:password123@localhost:27017/cafeteria?authSource=admin

# Clave secreta para firmar los JWT
JWT_SECRET=tu-clave-secreta-aqui-cambiar-en-prod

# Tiempo de expiracion de los tokens JWT
JWT_EXPIRATION=8h

# URL del frontend para configurar CORS
FRONTEND_URL=http://localhost:3000

NODE_ENV=development

# Datos del comercio para facturacion (SAR Honduras)
COMERCIO_NOMBRE=Cafeteria Inventario
COMERCIO_RTN=08019001000000
COMERCIO_CAI=0000000000000000
COMERCIO_FECHA_LIMITE_EMISION=2026-12-31
COMERCIO_ESTABLECIMIENTO=001
COMERCIO_PUNTO_EMISION=001
COMERCIO_RANGO_INICIAL=1
COMERCIO_RANGO_FINAL=100000

# Tasas de ISV (porcentaje en decimal)
ISV_TASA_15=0.15
ISV_TASA_18=0.18