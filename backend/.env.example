# Puerto en el que corre el servidor
PORT=4000

# URI de conexion a MongoDB
# NOTA: para desarrollo local con replica set single-node (docker-compose.dev.yml)
# se requiere directConnection=true para que el driver no intente descubrir
# otros miembros del replica set por hostname.
MONGODB_URI=mongodb://localhost:27017/cafeteria?replicaSet=rs0&directConnection=true

# Clave secreta para firmar los JWT
JWT_SECRET=tu-clave-secreta-aqui-cambiar-en-prod

# Tiempo de expiracion de los tokens JWT
JWT_EXPIRATION=8h

# URL del frontend para configurar CORS
FRONTEND_URL=http://localhost:3000

NODE_ENV=development

# Porcentaje de impuesto aplicado en la facturacion
IMPUESTO_PORCENTAJE=15
